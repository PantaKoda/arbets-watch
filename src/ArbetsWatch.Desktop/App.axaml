<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ArbetsWatch.Desktop.Controls"
             x:Class="ArbetsWatch.Desktop.App"
             RequestedThemeVariant="Default">
  <!--
    Visual language shared with Repo Watch: deep-space surfaces, a cyan HUD accent, neon status colors.
    Motion is reserved for activity (a refresh you asked for, the first download) and is switched off for any
    window carrying the "reduce-motion" class. Nothing animates while the window is idle.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0E8A5F" />
          <SolidColorBrush x:Key="StatusFailureBrush" Color="#D12A4A" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#A36200" />
          <SolidColorBrush x:Key="StatusRunningBrush" Color="#0081A8" />
          <SolidColorBrush x:Key="StatusNeutralBrush" Color="#5E6C84" />

          <LinearGradientBrush x:Key="SpaceSurfaceBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#F5F9FD" Offset="0" />
            <GradientStop Color="#E3ECF6" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="HudAccentBrush" Color="#006F8E" />
          <SolidColorBrush x:Key="HudFrameBrush" Color="#66006F8E" />
          <SolidColorBrush x:Key="HudDimBrush" Color="#56637A" />
          <SolidColorBrush x:Key="RowHoverBrush" Color="#14006F8E" />
          <SolidColorBrush x:Key="PanelBrush" Color="#0A006F8E" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#F5F9FD" />
          <BoxShadows x:Key="HudGlowShadow">0 0 6 0 #33006F8E</BoxShadows>
          <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#F5F9FD" />
          <SolidColorBrush x:Key="FullTimeBrush" Color="#0E8A5F" />
          <SolidColorBrush x:Key="PartTimeBrush" Color="#8A4FD1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#3DFFA2" />
          <SolidColorBrush x:Key="StatusFailureBrush" Color="#FF4D6D" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFB547" />
          <SolidColorBrush x:Key="StatusRunningBrush" Color="#3FE0FF" />
          <SolidColorBrush x:Key="StatusNeutralBrush" Color="#7C8BA6" />

          <LinearGradientBrush x:Key="SpaceSurfaceBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0E1B30" Offset="0" />
            <GradientStop Color="#060A14" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="HudAccentBrush" Color="#3FE0FF" />
          <SolidColorBrush x:Key="HudFrameBrush" Color="#803FE0FF" />
          <SolidColorBrush x:Key="HudDimBrush" Color="#A6B4CF" />
          <SolidColorBrush x:Key="RowHoverBrush" Color="#1A3FE0FF" />
          <SolidColorBrush x:Key="PanelBrush" Color="#0D3FE0FF" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#0B1322" />
          <BoxShadows x:Key="HudGlowShadow">0 0 6 0 #553FE0FF</BoxShadows>
          <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#0B1322" />
          <SolidColorBrush x:Key="FullTimeBrush" Color="#3DFFA2" />
          <SolidColorBrush x:Key="PartTimeBrush" Color="#C49BFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
      <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
      <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
      <x:Double x:Key="FontSizeCaption">11.5</x:Double>
      <x:Double x:Key="FontSizeHeading">16</x:Double>

      <!-- Icon geometries from Material Design Icons (Apache License 2.0). -->
      <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58a.5.5 0 0 0 .12-.61l-1.92-3.32a.5.5 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54A.48.48 0 0 0 13.92 2h-3.84a.48.48 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.73 8.47a.48.48 0 0 0 .12.61l2.03 1.58c-.05.3-.08.63-.08.94s.02.64.07.94l-2.03 1.58a.5.5 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.48.48 0 0 0-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z</StreamGeometry>
      <StreamGeometry x:Key="IconMinimize">M6 11h12v2H6z</StreamGeometry>
      <StreamGeometry x:Key="IconOpenExternal">M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zm5 16H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7z</StreamGeometry>
      <StreamGeometry x:Key="IconPlace">M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z</StreamGeometry>
      <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconDoneAll">M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19l12-12-1.42-1.41zM.41 13.41 6 19l1.41-1.41L1.83 12 .41 13.41z</StreamGeometry>
      <StreamGeometry x:Key="IconUpdate">M12 16.5l4-4h-3v-9h-2v9H8l4 4zm9-13h-6v1.99h6v14.03H3V5.49h6V3.5H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2v-14c0-1.1-.9-2-2-2z</StreamGeometry>
      <StreamGeometry x:Key="IconDetails">M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z</StreamGeometry>
      <StreamGeometry x:Key="IconArrowUp">M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FF1FB8D6" RegionColor="#FF070C18" />
        <ColorPaletteResources x:Key="Light" Accent="#FF006F8E" RegionColor="#FFF5F9FD" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Compact icon-only buttons; each has a tooltip and an accessible name. -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource HudDimBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>
    <Style Selector="Button.icon PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>

    <!-- Expand/collapse toggles stay quiet when checked. -->
    <Style Selector="ToggleButton.icon">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource HudDimBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>

    <!-- A refresh you asked for: the icon takes the accent and turns until it finishes. -->
    <Style Selector="Button.icon.spinning PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>
    <Style Selector="Window:not(.reduce-motion) Button.icon.spinning PathIcon">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.resize">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Chips: worktime and small facts (fully opaque text). -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource HudFrameBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource HudDimBrush}" />
    </Style>
    <Style Selector="Border.chip.fulltime">
      <Setter Property="BorderBrush" Value="{DynamicResource FullTimeBrush}" />
    </Style>
    <Style Selector="Border.chip.fulltime TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FullTimeBrush}" />
    </Style>
    <Style Selector="Border.chip.parttime">
      <Setter Property="BorderBrush" Value="{DynamicResource PartTimeBrush}" />
    </Style>
    <Style Selector="Border.chip.parttime TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PartTimeBrush}" />
    </Style>

    <!-- Unread: a small accent dot by the title. -->
    <Style Selector="Ellipse.unread">
      <Setter Property="Fill" Value="{DynamicResource HudAccentBrush}" />
    </Style>

    <!-- A newly detected ad glows once and fades (never with reduced motion: the dot stays). -->
    <Style Selector="Border.flash">
      <Setter Property="Background" Value="{DynamicResource HudAccentBrush}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Window:not(.reduce-motion) Border.flash[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:2.6" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.28" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Rows: soft hover glow with a short transition. -->
    <Style Selector="ListBox.hud ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>
    <Style Selector="ListBox.hud ListBoxItem /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.hud ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="ListBox.hud ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HudFrameBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.rowlink, ListBoxItem:selected Button.rowlink">
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.secondary">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource HudDimBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hud">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.brand">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="3" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>

    <!-- Filter bar: compact controls on the HUD surface. -->
    <Style Selector="Grid.filterbar Button, Grid.filterbar ToggleButton">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource HudFrameBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="Grid.filterbar ToggleButton:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HudAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.search /template/ TextBlock">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource HudDimBrush}" />
    </Style>

    <!-- Header "Update" pill: accent outline and text, fully opaque. -->
    <Style Selector="Button.update">
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>
    <Style Selector="Button.update:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>

    <!-- Pill that applies held-back updates. -->
    <Style Selector="Button.pill">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- Scan line: a thin indeterminate bar shown only while you wait. -->
    <Style Selector="ProgressBar.scan">
      <Setter Property="Height" Value="2" />
      <Setter Property="MinHeight" Value="2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
      <Setter Property="IsIndeterminate" Value="True" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Window.reduce-motion ProgressBar.scan">
      <Setter Property="IsIndeterminate" Value="False" />
      <Setter Property="Value" Value="100" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Window:not(.reduce-motion) c|StatusDot:active">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Pulse" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Pulse" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

  </Application.Styles>
</Application>
