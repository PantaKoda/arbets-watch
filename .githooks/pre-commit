#!/bin/sh
# Blocks commits that contain a DeepL API key. Enable once per clone:  git config core.hooksPath .githooks
if command -v pwsh >/dev/null 2>&1; then PS=pwsh; elif command -v powershell >/dev/null 2>&1; then PS=powershell; else
  echo "pre-commit: PowerShell (pwsh) is needed for the secret scan; install it or bypass knowingly with --no-verify." >&2
  exit 1
fi
exec "$PS" -NoProfile -ExecutionPolicy Bypass -File scripts/check-secrets.ps1 -Staged
